# MediaPilot no necesita estas variables para funcionar (todo se configura en la
# interfaz, en Configuración). Existen para despliegues sin interfaz o para
# apuntar a un Jackett/una biblioteca concretos.

# Jackett opcional: si no lo indicas, se busca solo en $HOME/appdata/jackett,
# /config/Jackett y %APPDATA%\Jackett
JACKETT_URL=http://127.0.0.1:9117
JACKETT_API_KEY=
JACKETT_CONFIG=
JACKETT_INDEXERS=

# TMDB (gratis en themoviedb.org) para el catálogo de Discover
TMDB_API_KEY=

# Raíz de la biblioteca (solo la usa el modo --scan de subtitles.py)
MEDIAPILOT_MEDIA_ROOT=$HOME/media
