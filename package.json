{
  "name": "mediapilot",
  "version": "1.0.18",
  "description": "MediaPilot — descargador automático de películas y series: TorBox/Real-Debrid, proveedores latino, biblioteca lista para Jellyfin",
  "license": "MIT",
  "author": "latinokodi",
  "repository": { "type": "git", "url": "git+https://github.com/latinokodi/MediaPilot.git" },
  "homepage": "https://github.com/latinokodi/MediaPilot#readme",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:server": "esbuild electron/server.ts --bundle --platform=node --format=cjs --outfile=dist-electron/server.cjs --external:electron --external:better-sqlite3",
    "server": "npm run build && npm run build:server && node dist-electron/server.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "electron .",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "pyinstaller": "cd electron/qbit-plugins && pyinstaller --onefile --name qbit-runner --distpath . --add-data \"engines:engines\" --add-data \"novaprinter.py:.\" --add-data \"helpers.py:.\" --hidden-import cloudscraper --clean qbit-runner.py && rm -rf build qbit-runner.spec",
    "dist": "npm run pyinstaller && npm run build && electron-builder",
    "dist:dir": "npm run pyinstaller && npm run build && electron-builder --dir",
    "spec": "esbuild spec/support/run.ts --bundle --platform=node --format=cjs --external:better-sqlite3 --external:electron --outfile=dist-electron/mp-spec.cjs && node dist-electron/mp-spec.cjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-progress": "^1.1.1",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-toast": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.1.6",
    "axios": "^1.7.9",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "fast-xml-parser": "^5.9.3",
    "gsap": "^3.12.5",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.6",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^4.1.10",
    "wait-on": "^8.0.1"
  }
}
